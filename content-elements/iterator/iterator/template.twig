{% apply spaceless %}
    {% set iteratorElementId = elementId ?: 'iterator-Hn4sWq' %}
    {% set iteratorPartId = iteratorPartId ?: 'iterator-part-Zc6yLb' %}
    {% set iteratorDropzoneId = dropzoneId ?: 'iterator-dropzone-Pk2mVe' %}
    {% set iteratorName = iteratorName ?: 'Iterator' %}

    <div data-bsi-element="{{ iteratorElementId }}" data-bsi-element-part="{{ iteratorPartId }}" data-bsi-iterator="{{ iteratorName }}" class="bsi-element-iterator-Hn4sWq bsi-iterator-element container">
        <div class="bsi-iterator-item" data-bsi-iterator-item="{{ iteratorName }}" data-bsi-dropzone="{{ iteratorDropzoneId }}">
            {% block iterator_dropzone %}{% endblock %}
        </div>
    </div>
{% endapply %}
